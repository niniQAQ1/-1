                case "2": handleCreateCourse(); break;
                case "3": handleFindStudentById(); break;
                case "4": handleFindStudentByName(); break;
                case "5": handleFindCourse(); break;
                case "6": handleEnroll(); break;
                case "7": handleAssignGrade(); break;
                case "8": handleUnenroll(); break;
                case "0":
                    System.out.println("系统已退出。");
                    return;
                default:
                    System.out.println("无效输入，请重新选择！");
            }
        }
    }

