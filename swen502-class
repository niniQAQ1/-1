import java.util.HashMap;
import java.util.Map;

public class UniversitySystem {
    // 维护多个 Map 以支持按不同条件快速查找
    private Map<Integer, Student> studentsById = new HashMap<>();
    private Map<String, Student> studentsByName = new HashMap<>();
    private Map<String, Course> coursesByCode = new HashMap<>();

    // 1. 添加学生
    public boolean addStudent(int id, String name) {
        if (studentsById.containsKey(id) || studentsByName.containsKey(name.toLowerCase())) {
            return false; // ID 或 姓名已存在
        }
        Student student = new Student(id, name);
        studentsById.put(id, student);
        studentsByName.put(name.toLowerCase(), student);
        return true;
    }

    // 2. 创建课程
    public boolean createCourse(String code, String title) {
        String upperCode = code.toUpperCase();
        if (coursesByCode.containsKey(upperCode)) {
            return false;
        }
        coursesByCode.put(upperCode, new Course(upperCode, title));
        return true;
    }

    // 3. 查找学生 (通过 ID)
    public Student getStudentById(int id) {
        return studentsById.get(id); // 使用 Map.get
    }

    // 4. 查找学生 (通过姓名)
    public Student getStudentByName(String name) {
        return studentsByName.get(name.toLowerCase()); // 使用 Map.get
    }

    // 5. 查找课程 (通过代码)
    public Course getCourseByCode(String code) {
        return coursesByCode.get(code.toUpperCase()); // 使用 Map.get
    }

    // 6. 选课
    public boolean enrollStudent(int studentId, String courseCode) {
        Student student = getStudentById(studentId);
        Course course = getCourseByCode(courseCode);

        if (student == null || course == null) {
            return false;
        }

        student.enrollCourse(course);
        course.addStudent(student);
        return true;
    }

    // 7. 退课
    public boolean unenrollStudent(int studentId, String courseCode) {
        Student student = getStudentById(studentId);
        Course course = getCourseByCode(courseCode);

        if (student == null || course == null) {
            return false;
        }

        student.unenrollCourse(course);
        course.removeStudent(student);
        return true;
    }

    // 8. 录入成绩
    public boolean assignGrade(int studentId, String courseCode, String grade) {
        Student student = getStudentById(studentId);
        Course course = getCourseByCode(courseCode);

        if (student == null || course == null) {
            return false;
        }

        student.completeCourse(course.getCode(), grade);
        course.assignGrade(student, grade);
        return true;
    }
}


