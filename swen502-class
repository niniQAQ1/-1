import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class Student {
    private int id;
    private String name;
    // 当前正在修读的课程列表
    private List<Course> enrolledCourses;
    // 已完成课程的成绩：Key 为课程代码，Value 为成绩（如 "A+"）
    private Map<String, String> completedGrades;

    public Student(int id, String name) {
        this.id = id;
        this.name = name;
        this.enrolledCourses = new ArrayList<>();
        this.completedGrades = new HashMap<>();
    }

    public int getId() {
        return id;
    }

    public String getName() {
        return name;
    }

    public List<Course> getEnrolledCourses() {
        return enrolledCourses;
    }

    public Map<String, String> getCompletedGrades() {
        return completedGrades;
    }

    // 选课
    public void enrollCourse(Course course) {
        if (!enrolledCourses.contains(course)) {
            enrolledCourses.add(course);
        }
    }

    // 退课
    public void unenrollCourse(Course course) {
        enrolledCourses.remove(course);
    }

    // 登记成绩（结课）
    public void completeCourse(String courseCode, String grade) {
        // 从在读列表中移除
        enrolledCourses.removeIf(c -> c.getCode().equalsIgnoreCase(courseCode));
        // 使用 put 方法将成绩存入 Map
        completedGrades.put(courseCode, grade);
    }

    @Override
    public String toString() {
        return name + " (ID: " + id + ")";
    }
}

