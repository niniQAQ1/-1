import java.io.File;
import java.io.FileNotFoundException;
import java.util.*;

public class FunWithWords {

    public static void main(String[] args) {
        // 替换为你的文件路径，如 "100k-AnneOfGreenGables.txt"
        String filePath = "100k-AnneOfGreenGables.txt";

        System.out.println("=== 任务 1：提取唯一单词与性能对比 ===");
        findUniqueWithList(filePath);
        findUniqueWithSet(filePath);

        System.out.println("\n=== 任务 2：统计单词出现频次 ===");
        countWordFrequency(filePath);
    }

    // 1.1 使用 ArrayList 寻找唯一单词
    public static void findUniqueWithList(String filePath) {
        List<String> uniqueWords = new ArrayList<>();
        long start = System.currentTimeMillis();

        try (Scanner scanner = new Scanner(new File(filePath))) {
            while (scanner.hasNext()) {
                String word = cleanWord(scanner.next());
                if (!word.isEmpty() && !uniqueWords.contains(word)) { // List 查找较慢
                    uniqueWords.add(word);
                }
            }
        } catch (FileNotFoundException e) {
            System.err.println("找不到文件: " + filePath);
            return;
        }

        long end = System.currentTimeMillis();
        System.out.println("ArrayList - 唯一单词数量: " + uniqueWords.size() + " | 耗时: " + (end - start) + " ms");
    }

    // 1.2 使用 HashSet 寻找唯一单词
    public static void findUniqueWithSet(String filePath) {
        Set<String> uniqueWords = new HashSet<>();
        long start = System.currentTimeMillis();

        try (Scanner scanner = new Scanner(new File(filePath))) {
            while (scanner.hasNext()) {
                String word = cleanWord(scanner.next());
                if (!word.isEmpty()) {
                    uniqueWords.add(word); // HashSet 自动去重且极快
                }
            }
        } catch (FileNotFoundException e) {
            System.err.println("找不到文件: " + filePath);
            return;
        }

        long end = System.currentTimeMillis();
        System.out.println("HashSet   - 唯一单词数量: " + uniqueWords.size() + " | 耗时: " + (end - start) + " ms");
    }

    // 2. 使用 HashMap 统计词频
    public static void countWordFrequency(String filePath) {
        Map<String, Integer> wordCounts = new HashMap<>();

        try (Scanner scanner = new Scanner(new File(filePath))) {
            while (scanner.hasNext()) {
                String word = cleanWord(scanner.next());
                if (word.isEmpty()) continue;

                // 如果存在就 +1，不存在则初始为 1
                wordCounts.put(word, wordCounts.getOrDefault(word, 0) + 1);
            }
        } catch (FileNotFoundException e) {
            System.err.println("找不到文件: " + filePath);
            return;
        }

        System.out.println("成功统计！独立单词总数: " + wordCounts.size());
        
        // 打印前 10 个单词示例
        System.out.println("部分单词频次示例:");
        int count = 0;
        for (Map.Entry<String, Integer> entry : wordCounts.entrySet()) {
            System.out.println("  " + entry.getKey() + ": " + entry.getValue());
            if (++count >= 10) break;
        }
    }

    // 清洗单词：转换为小写并去除标点符号
    private static String cleanWord(String raw) {
        return raw.toLowerCase().replaceAll("[^a-zA-Z0-9]", "");
    }
}
