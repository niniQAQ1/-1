full example：
// ==========================================
// 第一段：定义父类（抽象类 Abstract Class）[cite: 6]
// ==========================================
abstract class Noodle {
    private String name;

    public Noodle(String name) {
        this.name = name;
    }

    public abstract void makeSoup(); // 抽象方法[cite: 6]
}


// ==========================================
// 第二段：定义接口（Interface 技能标准）[cite: 6]
// ==========================================
interface TakeoutService {
    void packFood(); // 纯留白方法[cite: 6]
}


// ==========================================
// 第三段：子类继承父类 + 实现接口（真正干活的 Class）
// ==========================================
class LanzhouNoodle extends Noodle implements TakeoutService {

    public LanzhouNoodle() {
        super("牛肉拉面"); // 叫老爸[cite: 5]
    }

    // 重写父类的抽象方法[cite: 6]
    @Override
    public void makeSoup() {
        System.out.println("加清汤牛肉汤底！");
    }

    // 重写接口的抽象方法[cite: 6]
    @Override
    public void packFood() {
        System.out.println("打包拉面，封紧盖子！");
    }
}


// ==========================================
// 第四段：Main 运行类（程序的启动总开关）
// ==========================================
public class Main {
    public static void main(String[] args) {
        LanzhouNoodle n = new LanzhouNoodle();
        n.makeSoup();
        n.packFood();
    }
}

